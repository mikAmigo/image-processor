# ============================================================
# Reservation Bot – Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ----- Resy credentials -----
# API key: open resy.com, open dev-tools Network tab, look for the
# "authorization" header on any API request. It looks like:
#   ResyAPI api_key="VbWk7s3L4KiK5fzlO7JD3Q5EYolJI7n5"
RESY_API_KEY=
RESY_EMAIL=
RESY_PASSWORD=

# ----- OpenTable (optional) -----
OPENTABLE_API_KEY=

# ----- Twilio SMS notifications (optional) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
NOTIFY_PHONE=+1XXXXXXXXXX

# ----- Email notifications (optional) -----
# Works with Gmail app passwords or any SMTP provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# ----- Bot settings -----
POLL_INTERVAL_SECONDS=120
PARTY_SIZE=2
# Set to "true" to auto-book the first matching Resy slot.
# WARNING: this will charge your card on file with Resy.
AUTO_BOOK=false
